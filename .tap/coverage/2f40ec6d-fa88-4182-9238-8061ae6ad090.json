        "sourcesContent": [
          "class CRC32 {\n    constructor () {\n        this.bit = new Uint32Array(1);\n        this.crc = 0;\n        this.c = 0;\n\n        this.table = [];\n        let c;\n        for (let i = 0; i < 256; i++) {\n            c = i;\n            for (let j = 0; j < 8; j++) {\n                c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);\n            }\n            this.table[i] = c >>> 0;\n        }\n    }\n\n    update (uint8a, position = 0, length = uint8a.length) {\n        let crc = (~this.crc) >>> 0;\n        for (let i = 0; i < length; i++) {\n            crc = (crc >>> 8) ^ this.table[(crc ^ uint8a[position + i]) & 0xff];\n        }\n        this.crc = (~crc) >>> 0;\n        return this;\n    }\n\n    get digest () {\n        return this.crc;\n    }\n}\n\nexport {CRC32};\n"

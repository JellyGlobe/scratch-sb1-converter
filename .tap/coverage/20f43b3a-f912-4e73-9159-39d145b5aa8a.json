        "sourcesContent": [
          "class Adler32 {\n    constructor () {\n        this.adler = 1;\n    }\n\n    update (uint8a, position, length) {\n        let a = this.adler & 0xffff;\n        let b = this.adler >>> 16;\n        for (let i = 0; i < length; i++) {\n            a = (a + uint8a[position + i]) % 65521;\n            b = (b + a) % 65521;\n        }\n        this.adler = (b << 16) | a;\n        return this;\n    }\n\n    get digest () {\n        return this.adler;\n    }\n}\n\nexport {Adler32};\n"
        ],
